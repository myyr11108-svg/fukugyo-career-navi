---
interface Props {
  rank?: number;
  name: string;
  summary: string;
  pros: string[];
  cta: string;
  url: string;
  badge?: string;
}

const { rank, name, summary, pros, cta, url, badge } = Astro.props;
const rankColors = ['bg-yellow-400', 'bg-gray-300', 'bg-amber-600'];
const rankColor = rank ? (rankColors[rank - 1] ?? 'bg-primary-500') : 'bg-primary-500';
---

<div class="affiliate-box">
  <div class="flex items-start gap-4">
    {rank && (
      <div class={`ranking-badge ${rankColor} shrink-0 mt-1`}>{rank}</div>
    )}
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-1 flex-wrap">
        <h4 class="text-lg font-bold text-gray-900">{name}</h4>
        {badge && (
          <span class="text-xs bg-accent-500 text-white font-bold px-2 py-0.5 rounded">{badge}</span>
        )}
      </div>
      <p class="text-sm text-gray-700 mb-3">{summary}</p>
      <ul class="space-y-1 mb-4">
        {pros.map(p => (
          <li class="text-sm text-gray-700 flex items-start gap-2">
            <span class="text-green-500 font-bold shrink-0">✓</span>{p}
          </li>
        ))}
      </ul>
      <a href={url} target="_blank" rel="nofollow noopener noreferrer" class="btn-primary text-sm">
        {cta}
      </a>
    </div>
  </div>
</div>
