---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  pubDate: Date;
}

const { title, description, slug, category, pubDate } = Astro.props;

const categoryConfig: Record<string, { label: string; color: string; badgeClass: string }> = {
  tensha:      { label: '転職エージェント',     color: '#2563eb', badgeClass: 'badge-tensha' },
  programming: { label: 'プログラミングスクール', color: '#16a34a', badgeClass: 'badge-programming' },
  fukugyo:     { label: '副業の始め方',         color: '#7c3aed', badgeClass: 'badge-fukugyo' },
  ai:          { label: 'AI活用・副業',         color: '#0891b2', badgeClass: 'badge-ai' },
};
const cfg = categoryConfig[category] ?? { label: category, color: '#6b7280', badgeClass: '' };

const formatDate = (d: Date) =>
  d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a href={`/blog/${slug}`} class="card block group no-underline">
  <!-- カテゴリカラーストライプ -->
  <div class="h-1.5 w-full" style={`background: linear-gradient(90deg, ${cfg.color}, ${cfg.color}99)`}></div>
  <div class="p-5">
    <div class="flex items-center justify-between mb-3">
      <span class={cfg.badgeClass}>{cfg.label}</span>
      <time class="text-xs text-gray-400">{formatDate(pubDate)}</time>
    </div>
    <h3 class="text-sm font-bold text-gray-800 group-hover:text-primary-600 transition-colors leading-snug mb-2 line-clamp-2">
      {title}
    </h3>
    <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed mb-3">{description}</p>
    <div class="flex items-center text-xs font-bold text-primary-600 group-hover:gap-2 transition-all">
      <span>続きを読む</span>
      <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
    </div>
  </div>
</a>
