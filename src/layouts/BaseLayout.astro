---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
}

const { title, description, canonical, ogType = 'website' } = Astro.props;
const siteUrl = 'https://fukugyo-career-navi.com';
const pageUrl = canonical ?? siteUrl + Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="副業キャリアナビ" />
    <meta property="og:locale" content="ja_JP" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Affiliate disclosure (required) -->
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 no-underline">
          <span class="text-primary-600 text-2xl font-bold">副業キャリアナビ</span>
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
          <a href="/category/tensha" class="text-gray-600 hover:text-primary-600 no-underline">転職エージェント</a>
          <a href="/category/programming" class="text-gray-600 hover:text-primary-600 no-underline">プログラミングスクール</a>
          <a href="/category/fukugyo" class="text-gray-600 hover:text-primary-600 no-underline">副業の始め方</a>
        </nav>
        <!-- Mobile menu toggle placeholder -->
        <button class="md:hidden text-gray-600" aria-label="メニュー">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-gray-800 text-gray-300 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <p class="text-white font-bold mb-3">副業キャリアナビ</p>
            <p class="text-sm">転職・副業・スキルアップに関する情報を発信するメディアです。</p>
          </div>
          <div>
            <p class="text-white font-bold mb-3">カテゴリ</p>
            <ul class="space-y-1 text-sm">
              <li><a href="/category/tensha" class="hover:text-white no-underline">転職エージェント</a></li>
              <li><a href="/category/programming" class="hover:text-white no-underline">プログラミングスクール</a></li>
              <li><a href="/category/fukugyo" class="hover:text-white no-underline">副業の始め方</a></li>
            </ul>
          </div>
          <div>
            <p class="text-white font-bold mb-3">サイト情報</p>
            <ul class="space-y-1 text-sm">
              <li><a href="/about" class="hover:text-white no-underline">このサイトについて</a></li>
              <li><a href="/privacy" class="hover:text-white no-underline">プライバシーポリシー</a></li>
              <li><a href="/disclaimer" class="hover:text-white no-underline">免責事項</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-700 pt-6 text-sm text-center">
          <p class="mb-2">当サイトはアフィリエイト広告を利用しています。</p>
          <p>© 2026 副業キャリアナビ All Rights Reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
