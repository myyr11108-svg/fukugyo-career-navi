---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const categories = [
  {
    key: 'tensha',
    label: '転職エージェント',
    desc: '評判・口コミから厳選したエージェント比較。IT・ハイクラス・総合型を網羅',
    icon: '💼',
    gradient: 'linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%)',
    border: '#93c5fd',
    accent: '#2563eb',
  },
  {
    key: 'programming',
    label: 'プログラミングスクール',
    desc: '未経験からエンジニアへ。料金・カリキュラム・就職支援を徹底比較',
    icon: '💻',
    gradient: 'linear-gradient(135deg, #dcfce7 0%, #f0fdf4 100%)',
    border: '#86efac',
    accent: '#16a34a',
  },
  {
    key: 'fukugyo',
    label: '副業の始め方',
    desc: '会社員が安全に始められる副業を厳選。月5万円を目指す実践ガイド',
    icon: '📈',
    gradient: 'linear-gradient(135deg, #f3e8ff 0%, #faf5ff 100%)',
    border: '#c4b5fd',
    accent: '#7c3aed',
  },
  {
    key: 'ai',
    label: 'AI活用・副業',
    desc: 'ChatGPT・AIツールを使った副業・仕事効率化・AIエンジニア転職まで最新情報を解説',
    icon: '🤖',
    gradient: 'linear-gradient(135deg, #cffafe 0%, #ecfeff 100%)',
    border: '#67e8f9',
    accent: '#0891b2',
  },
];
---

<BaseLayout
  title="副業キャリアナビ｜転職・副業・スキルアップ情報"
  description="転職エージェント比較・プログラミングスクール比較・副業の始め方を徹底解説。2026年最新情報で稼げるキャリアプランを提案します。"
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 px-4 text-white" style="background: linear-gradient(135deg, #1e40af 0%, #2563eb 40%, #7c3aed 100%);">
    <!-- 背景デコレーション -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full opacity-20" style="background: radial-gradient(circle, #a78bfa, transparent 70%);"></div>
      <div class="absolute -bottom-16 -left-16 w-72 h-72 rounded-full opacity-20" style="background: radial-gradient(circle, #60a5fa, transparent 70%);"></div>
    </div>
    <div class="relative max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 bg-white bg-opacity-20 backdrop-blur-sm text-white text-xs font-bold px-4 py-1.5 rounded-full mb-6">
        🎯 2026年最新情報に対応
      </div>
      <h1 class="text-3xl md:text-5xl font-black mb-5 leading-tight">
        転職・副業・スキルアップで<br/>
        <span style="background: linear-gradient(90deg, #fde68a, #fbbf24); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
          人生をアップデート
        </span>
      </h1>
      <p class="text-blue-100 text-base md:text-lg mb-10 leading-relaxed">
        転職エージェント・プログラミングスクール・副業の始め方を<br class="hidden md:block"/>プロ目線で徹底比較。あなたに合った一歩を見つけよう。
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/category/tensha" class="btn-primary no-underline text-center">💼 転職エージェントを探す</a>
        <a href="/category/fukugyo" class="btn-outline no-underline text-center">📈 副業を始める</a>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 py-5 grid grid-cols-3 gap-4 text-center">
      <div>
        <p class="text-2xl font-black text-primary-600">11<span class="text-base">記事</span></p>
        <p class="text-xs text-gray-500 mt-0.5">厳選比較記事</p>
      </div>
      <div>
        <p class="text-2xl font-black text-primary-600">4<span class="text-base">ジャンル</span></p>
        <p class="text-xs text-gray-500 mt-0.5">転職・スクール・副業</p>
      </div>
      <div>
        <p class="text-2xl font-black text-primary-600">無料</p>
        <p class="text-xs text-gray-500 mt-0.5">すべて無料で読める</p>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-6xl mx-auto px-4 py-14">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-black text-gray-900">カテゴリから探す</h2>
      <p class="text-gray-500 text-sm mt-2">あなたの目的に合った情報をすぐに見つけられます</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {categories.map(cat => (
        <a
          href={`/category/${cat.key}`}
          class="block rounded-2xl p-7 no-underline group transition-all duration-300 hover:-translate-y-1"
          style={`background: ${cat.gradient}; border: 2px solid ${cat.border}; box-shadow: 0 4px 16px ${cat.border}55;`}
        >
          <div class="text-4xl mb-4">{cat.icon}</div>
          <h3 class="text-lg font-black mb-2" style={`color: ${cat.accent}`}>{cat.label}</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">{cat.desc}</p>
          <span class="text-xs font-bold" style={`color: ${cat.accent}`}>詳しく見る →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest articles -->
  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-black text-gray-900">📝 最新記事</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {latestPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            category={post.data.category}
            pubDate={post.data.pubDate}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-black text-center text-gray-900 mb-8">このサイトが選ばれる理由</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { icon: '🔍', title: '中立的な比較', desc: '特定サービスに偏らず、メリット・デメリットを公平に掲載' },
          { icon: '📅', title: '常に最新情報', desc: '2026年の最新キャンペーン・料金・実績を随時更新中' },
          { icon: '✅', title: '実態に即した情報', desc: '利用者の口コミ・公式情報を元に信頼性の高い記事を執筆' },
        ].map(item => (
          <div class="card p-6 text-center">
            <div class="text-4xl mb-3">{item.icon}</div>
            <h3 class="font-black text-gray-900 mb-2">{item.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="mx-4 mb-16 rounded-3xl overflow-hidden" style="background: linear-gradient(135deg, #1e40af, #7c3aed);">
    <div class="px-8 py-12 text-center text-white">
      <p class="text-sm font-bold text-blue-200 mb-2">✨ まずは無料で確認</p>
      <h2 class="text-2xl md:text-3xl font-black mb-4">転職・副業の第一歩を踏み出そう</h2>
      <p class="text-blue-100 text-sm mb-8">相談・登録はすべて無料。プロのサポートでキャリアを変える。</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/category/tensha" class="btn-primary no-underline text-center">転職エージェントを探す</a>
        <a href="/category/programming" class="btn-outline no-underline text-center">スクールを比較する</a>
      </div>
    </div>
  </section>
</BaseLayout>
