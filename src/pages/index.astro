---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const categories = [
  {
    key: 'tensha',
    label: '転職エージェント',
    desc: '評判・口コミから厳選したエージェント比較。IT・ハイクラス・総合型を網羅',
    icon: '💼',
    color: 'bg-blue-50 border-blue-200',
  },
  {
    key: 'programming',
    label: 'プログラミングスクール',
    desc: '未経験からエンジニアへ。料金・カリキュラム・就職支援を徹底比較',
    icon: '💻',
    color: 'bg-green-50 border-green-200',
  },
  {
    key: 'fukugyo',
    label: '副業の始め方',
    desc: '会社員が安全に始められる副業を厳選。月5万円を目指す実践ガイド',
    icon: '📈',
    color: 'bg-purple-50 border-purple-200',
  },
];
---

<BaseLayout
  title="副業キャリアナビ｜転職・副業・スキルアップ情報"
  description="転職エージェント比較・プログラミングスクール比較・副業の始め方を徹底解説。2026年最新情報で稼げるキャリアプランを提案します。"
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-600 to-primary-700 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl md:text-4xl font-bold mb-4 leading-tight">
        転職・副業・スキルアップで<br class="hidden md:block"/>人生をアップデート
      </h1>
      <p class="text-primary-100 text-lg mb-8">
        2026年最新情報をもとに、あなたに合った転職エージェント・プログラミングスクール・副業をご紹介します
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/category/tensha" class="btn-primary">転職エージェントを探す →</a>
        <a href="/category/programming" class="bg-white text-primary-700 hover:bg-primary-50 font-bold py-3 px-6 rounded-lg transition-colors">スクールを比較する</a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-center mb-8">カテゴリから探す</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {categories.map(cat => (
        <a href={`/category/${cat.key}`} class={`card block border-2 ${cat.color} p-6 hover:shadow-md transition-shadow no-underline group`}>
          <div class="text-3xl mb-3">{cat.icon}</div>
          <h3 class="text-lg font-bold text-gray-800 group-hover:text-primary-600 mb-2">{cat.label}</h3>
          <p class="text-sm text-gray-600">{cat.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest articles -->
  <section class="max-w-6xl mx-auto px-4 pb-12">
    <h2 class="text-2xl font-bold mb-6">最新記事</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {latestPosts.map(post => (
        <ArticleCard
          title={post.data.title}
          description={post.data.description}
          slug={post.slug}
          category={post.data.category}
          pubDate={post.data.pubDate}
        />
      ))}
    </div>
  </section>

  <!-- Trust signals -->
  <section class="bg-gray-100 py-10 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-xl font-bold mb-6 text-gray-700">このサイトの特徴</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <div class="text-2xl mb-2">🔍</div>
          <h3 class="font-bold mb-1">徹底比較</h3>
          <p class="text-sm text-gray-600">サービスの特徴・料金・評判を中立的な立場で比較</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <div class="text-2xl mb-2">📅</div>
          <h3 class="font-bold mb-1">最新情報</h3>
          <p class="text-sm text-gray-600">2026年最新のキャンペーン・料金情報を随時更新</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <div class="text-2xl mb-2">✅</div>
          <h3 class="font-bold mb-1">信頼性重視</h3>
          <p class="text-sm text-gray-600">実際の利用者の口コミ・公式情報に基づいて執筆</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
